{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':automergeDigest',
    ':automergeBranch',
    'helpers:pinGitHubActionDigests',
  ],
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  suppressNotifications: ['prIgnoreNotification'],
  rebaseWhen: 'conflicted',
  schedule: ['on saturday'],
  packageRules: [
    {
      // Merged straight to main once the validate workflow passes.
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
      automergeType: 'branch',
    },
    {
      // One PR for all BlueSpice images, merged by hand: every BlueSpice
      // update runs its database update (installer Job) and has needed
      // config changes before (see AGENTS.md).
      matchPackageNames: ['bluespice/**'],
      groupName: 'BlueSpice',
      versioning: 'loose', // hotfix tags like 5.2.7.1
      automerge: false,
    },
  ],
  argocd: {
    // Chart versions in Argo CD Applications (app-template, ...).
    managerFilePatterns: ['/(^|/)(manifests|environment|cluster)/.+\\.ya?ml$/'],
  },
  kubernetes: {
    managerFilePatterns: ['/(^|/)manifests/.+\\.ya?ml$/'],
  },
  customManagers: [
    {
      // Image repository/tag pairs in Helm values embedded in Argo CD
      // Applications (bjw-s app-template).
      customType: 'regex',
      managerFilePatterns: ['/(^|/)manifests/.+\\.ya?ml$/'],
      matchStrings: [
        'repository:\\s*["\']?(?<depName>[^\\s"\']+)["\']?\\s*\\n\\s*tag:\\s*["\']?(?<currentValue>[^\\s"\']+)["\']?',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
