{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':automergeDigest',
    ':automergeBranch',
    'helpers:pinGitHubActionDigests',
  ],
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  suppressNotifications: ['prIgnoreNotification'],
  rebaseWhen: 'conflicted',
  schedule: ['on saturday'],
  // Supply-chain cooldown (2026-11-06): nothing is proposed before it has
  // been public this long, so a compromised release is usually pulled first.
  minimumReleaseAge: '3 days',
  packageRules: [
    {
      matchUpdateTypes: ['minor', 'major'],
      minimumReleaseAge: '7 days',
    },
    {
      // Merged straight to main once the validate workflow passes.
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
      automergeType: 'branch',
    },
    {
      // One PR for all BlueSpice images, merged by hand: every BlueSpice
      // update runs its database update (installer Job) and has needed
      // config changes before (see AGENTS.md).
      matchPackageNames: ['bluespice/**'],
      groupName: 'BlueSpice',
      versioning: 'loose', // hotfix tags like 5.2.7.1
      automerge: false,
    },
    {
      // MariaDB: LTS lines only (10.11, 11.4, 11.8, and x.3 from 12 on).
      // Rolling releases (12.0-12.2, 13.0, ...) lose support within months.
      matchPackageNames: ['docker.io/library/mariadb', 'mariadb'],
      allowedVersions: '/^(10\\.11|11\\.4|11\\.8|(1[2-9]|[2-9][0-9])\\.3)\\.[0-9]+$/',
    },
    {
      // Review application upgrades on the playground before the event.
      matchPackageNames: ['ghcr.io/open-tech-quest/ctfd-plugin'],
      automerge: false,
    },
  ],
  argocd: {
    // Chart versions in Argo CD Applications (app-template, ...).
    managerFilePatterns: ['/(^|/)(manifests|environment|cluster)/.+\\.ya?ml$/'],
  },
  kubernetes: {
    managerFilePatterns: ['/(^|/)manifests/.+\\.ya?ml$/'],
  },
  customManagers: [
    {
      // Image repository/tag pairs in Helm values embedded in Argo CD
      // Applications (bjw-s app-template).
      customType: 'regex',
      managerFilePatterns: ['/(^|/)manifests/.+\\.ya?ml$/'],
      matchStrings: [
        'repository:\\s*["\']?(?<depName>[^\\s"\']+)["\']?\\s*\\n\\s*tag:\\s*["\']?(?<currentValue>[^\\s"\']+)["\']?',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
